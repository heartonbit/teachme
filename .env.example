# OpenAI-compatible Chat Completions endpoint configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-model-id

MAX_ARTICLES_PER_SOURCE=3
MAX_TOTAL_INPUT_CHARS=24000
TIMEZONE=UTC
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
LLM_MAX_TOKENS=4000
OUTPUT_DIR=result
PROMPT_FILE=prompts/news_to_lesson.md
LOG_LEVEL=INFO

# Optional: email the generated lesson via Resend after each successful run.
# Without a verified domain, Resend only delivers to your own account email.
# NOTIFY_EMAIL=reader@example.com,other@example.com
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=teachme@your-verified-domain.com

# Optional: a JSON array of {"id", "name", "url"} objects.
# The URL may be an RSS/Atom feed or a public page exposing an RSS/Atom link.
# NEWS_SOURCES_JSON='[{"id":"example","name":"Example News","url":"https://example.com/news"}]'